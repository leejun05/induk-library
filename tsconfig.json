{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // 1. 모듈 시스템을 브라우저/빌더 환경에 맞게 변경 (nodenext -> esnext 또는 bundler)
    "module": "esnext",
    "moduleResolution": "bundler", // <-- 이 줄이 없다면 추가해 주세요!
    "target": "esnext",
    "types": [],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    
    // 2. 이 부분을 true에서 false로 변경하거나 아예 지워주세요!
    "verbatimModuleSyntax": false, 
    
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}